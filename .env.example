# Copia questo file in `.env` e riempi i valori. Il `.env` NON si versiona.
#
# Perche' esiste: dice QUALI variabili servono senza che nessuna chiave vera
# passi di mano. Chi clona il progetto sa cosa gli serve prima di sbatterci.
#
# E perche' NON si mettono le chiavi qui: `gitleaks` gira su questo motore
# (`python3 tools/security_scan.py`) e trova cio' che e' tracciato. Un segreto
# in un file versionato non e' un rischio: e' un fatto gia' avvenuto, e l'unico
# rimedio e' ruotare la chiave. Vedi la skill `ad-integrazioni`.

# ── Esempio: un servizio che NOI chiamiamo ────────────────────────────────
# SLACK_TOKEN=              # da api.slack.com/apps -> OAuth & Permissions
# GOOGLE_API_KEY=           # da console.cloud.google.com -> Credentials
# MAILERLITE_API_KEY=       # da dashboard.mailerlite.com -> Integrations -> API

# ── Esempio: un servizio che chiama LUI (webhook) ────────────────────────
# WEBHOOK_SECRET=           # il segreto che il servizio usa per firmare le sue richieste
